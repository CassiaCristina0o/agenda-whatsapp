# Evolution API
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCE=agenda-whatsapp

# Grupo que o bot atende
AGENDA_GROUP_ID=

EVOLUTION_API_KEY=sua-chave-da-evolution-aqui

# Lembretes: 1s=1 semana, 3d=3 dias, 3h=3 horas, 0=1 min antes
LEMBRETES=1s,3d,3h,0
INTERVALO_LEMBRETES_SEGUNDOS=30
ATRASO_TOLERADO_HORAS=1
MINUTOS_VISIVEL_APOS=2

# Postgres da Evolution
POSTGRES_PASSWORD=
