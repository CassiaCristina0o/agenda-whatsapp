# Evolution API (lido pelo docker-compose.yml)
# AUTHENTICATION_API_KEY e EVOLUTION_API_KEY devem ter o mesmo valor.
AUTHENTICATION_API_KEY=sua-chave-da-evolution-aqui
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:sua-senha@postgres:5432/evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_DATA_LABELS=true
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379

# Senha do Postgres (a mesma de DATABASE_CONNECTION_URI)
POSTGRES_PASSWORD=sua-senha

# Usada pelo sincronizar_webhook.sh
EVOLUTION_API_KEY=sua-chave-da-evolution-aqui
